#!/bin/sh

SEND_MESSAGE="True"

#LINE=$(cat /home/user/.dbus/session-bus/* | grep DBUS_SESSION_BUS_ADDRESS= | tail -n 1)
#BUS=${LINE:25}

IFS="_"
set -- "junk" ${1}
ACTION=${2}
DEVICE=${3}
FS=${4}
SIZE=${5}

LINEBREAK="
"

case x"${ACTION}" in
    x"A")
        [ x"${SEND_MESSAGE}" = x"True" ] && /etc/qubes-rpc/liteqube.Message "Device connected: ${DEVICE}${LINEBREAK}${FS} ${SIZE}"
        ;;
    x"R")
        [ x"${SEND_MESSAGE}" = x"True" ] && /etc/qubes-rpc/liteqube.Message "Device disconnected: ${DEVICE}"
        ;;
esac

#sudo -u user /bin/sh -c "DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=${BUS} dbus-send --dest=org.awesomewm.awful --type=method_call --print-reply / org.awesomewm.awful.Remote.Eval string:\"storage_state('${ACTION}', '${QREXEC_REMOTE_DOMAIN}', '${DEVICE}', '${FS}', '${SIZE}')\"" 1>/dev/null 2>&1
# Awesome notifier is off by default
#sudo -u "#1000" /bin/sh -c "DISPLAY=:0 dbus-send --dest=org.awesomewm.awful --type=method_call --print-reply / org.awesomewm.awful.Remote.Eval string:\"storage_state('${ACTION}', '${QREXEC_REMOTE_DOMAIN}', '${DEVICE}', '${FS}', '${SIZE}')\"" 1>/dev/null 2>&1

exit 0
