#!/bin/sh

SEND_MESSAGE="True"

LINE=$(cat /home/user/.dbus/session-bus/* | grep DBUS_SESSION_BUS_ADDRESS= | tail -n 1)
BUS=${LINE:25}

case x"${1}" in
    x"connecting")
        [ x"${SEND_MESSAGE}" = x"True" ] && /etc/qubes-rpc/liteqube.Message "VPN connecting"
        ;;
    x"connected")
        [ x"${SEND_MESSAGE}" = x"True" ] && /etc/qubes-rpc/liteqube.Message "VPN connected"
        ;;
    x"disconnected")
        [ x"${SEND_MESSAGE}" = x"True" ] && /etc/qubes-rpc/liteqube.Message "VPN disconnecting"
        ;;
esac

#sudo -u user /bin/sh -c "DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=${BUS} dbus-send --dest=org.awesomewm.awful --type=method_call --print-reply / org.awesomewm.awful.Remote.Eval string:\"vpn_state('${1}')\"" 1>/dev/null 2>&1
sudo -u user /bin/sh -c "DISPLAY=:0 dbus-send --dest=org.awesomewm.awful --type=method_call --print-reply / org.awesomewm.awful.Remote.Eval string:\"vpn_state('${1}')\"" 1>/dev/null 2>&1

exit 0
