#!/bin/sh

SEND_MESSAGE="True"

#LINE=$(cat /home/user/.dbus/session-bus/* | grep DBUS_SESSION_BUS_ADDRESS= | tail -n 1)
#BUS=${LINE:25}

case x"${1}" in
    x"100")
        [ x"${SEND_MESSAGE}" = x"True" ] && /etc/qubes-rpc/liteqube.Message "Tor connected"
        ;;
    x"200")
        [ x"${SEND_MESSAGE}" = x"True" ] && /etc/qubes-rpc/liteqube.Message "Tor disconnected"
        ;;
    x"999")
        true
        ;;
    *)
        [ x"${SEND_MESSAGE}" = x"True" ] && /etc/qubes-rpc/liteqube.Message "Tor connecting"
        ;;
esac

sudo -u "#1000" /bin/sh -c "DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=${BUS} dbus-send --dest=org.awesomewm.awful --type=method_call --print-reply / org.awesomewm.awful.Remote.Eval string:\"tor_state(${1})\"" 1>/dev/null 2>&1

exit 0
