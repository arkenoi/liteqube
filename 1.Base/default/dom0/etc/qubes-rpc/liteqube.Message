#!/bin/bash

# Show a message from the calling qube as a desktop notification in dom0.
#
# The calling qube controls only the text: the service argument, in which qrexec has already replaced
# every character other than letters, digits and "_.+-" with "_". Here "_" stands for a space. The title
# is the qube's name and the icon is the qube's label icon, as on stock Qubes notifications; both come
# from dom0. The text reaches notify-send as a separate argument after "--", so no shell or option
# parsing applies to it.
#
# liteqube.Error and the liteqube.Signal* services run this script with their own text. They may set
# LQ_URGENCY and LQ_TIMEOUT; a calling qube cannot set environment variables.

TEXT="${1//_/ }"
[ -n "${TEXT}" ] || exit 0

QUBE="${QREXEC_REMOTE_DOMAIN:-dom0}"
URGENCY="${LQ_URGENCY:-normal}"
TIMEOUT="${LQ_TIMEOUT:-2000}"

ICON="$(timeout 5 qvm-prefs "${QUBE}" icon 2>/dev/null)"
if [ -z "${ICON}" ] ; then
    if [ x"${URGENCY}" = x"critical" ] ; then ICON="dialog-error" ; else ICON="dialog-information" ; fi
fi

# dom0 services run as the desktop user, but without its session environment
BUS="/run/user/$(id -u)/bus"
[ -S "${BUS}" ] && export DBUS_SESSION_BUS_ADDRESS="unix:path=${BUS}"
export DISPLAY="${DISPLAY:-:0}"

notify-send --urgency="${URGENCY}" --expire-time="${TIMEOUT}" --icon="${ICON}" --app-name="Qube: ${QUBE}" \
    -- "${QUBE}" "${TEXT}" >/dev/null 2>&1

exit 0
